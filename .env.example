# Copy this file to .env and fill in what you have. Never commit .env.
# With only SESSION_SECRET, the app runs on recorded Sarvam answers and the
# flag defaults in code. Where to get each key: README.md, "Plug in the
# services". After a change, restart and run npm run doctor.

# Server
# 32 or more random characters. The server does not start without it. Make one:
# node -p "require('node:crypto').randomBytes(32).toString('base64url')"
SESSION_SECRET=
# The live address, for links in messages and QR codes. HTTPS, because
# browsers allow the microphone only in a secure context.
# Without it: http://localhost and the port.
PUBLIC_URL=
# SQLite and photos. Without it: ./data
DATA_DIR=./data
PORT=8080
HOST=0.0.0.0

# Sarvam AI (README.md, "Plug in the services", Sarvam AI)
# live or recorded. Without it: recorded, with the "Recorded" badge.
SARVAM_MODE=recorded
# Make the key at https://indus.sarvam.ai/key-management. It shows one time only.
# Without it: recorded mode only.
SARVAM_API_KEY=
# Without it: https://api.sarvam.ai
SARVAM_BASE_URL=

# Flagsmith (README.md, "Plug in the services", Flagsmith)
# The server-side key of one environment: Development in .env, Production in
# the deploy secrets. Without it: the flag defaults in code.
FLAGSMITH_ENVIRONMENT_KEY=
# The Flagsmith API base. Without it: the SDK default.
FLAGSMITH_API_URL=
# Organisation Settings, API Access. scripts/flagsmith-setup.ts and
# npm run doctor use it, and so does the rollback on /ops (see below).
# Without it: the setup script stops with a message, and /ops changes an
# override in the memory of the server.
FLAGSMITH_ORG_API_KEY=
# Only scripts/flagsmith-setup.ts reads the next three. Run it with:
# npm run flagsmith-setup
# The number of the project, from the dashboard address /project/<number>/.
# Without it: the script lists the projects and stops.
FLAGSMITH_PROJECT_ID=
# The environment of the live address: the experiment, the webhook and the
# rollback values. Without it: Production.
FLAGSMITH_LIVE_ENVIRONMENT=
# The Flagsmith management API base. FLAGSMITH_API_URL is for the SDK only.
# Without it: https://api.flagsmith.com/api/v1/
FLAGSMITH_ADMIN_API_URL=
# The /ops page sends the NudgeBee rollback change to Flagsmith (the same
# PATCH as nudgebee/rollback-lang-kn.yaml) when FLAGSMITH_ENVIRONMENT_KEY,
# FLAGSMITH_ORG_API_KEY and the next three are set. npm run flagsmith-setup
# prints the three values. Without them: the change stays in the memory of
# the server, and /ops says so.
FLAGSMITH_ROLLBACK_ENVIRONMENT_KEY=
FLAGSMITH_OPS_READING_FEATURE_ID=
FLAGSMITH_LANG_KN_SEGMENT_ID=

# Web push is on the roadmap (README.md, "Roadmap"). The server checks these
# keys at start, but nothing sends a push yet. npm run vapid makes the three
# lines. VAPID_SUBJECT is a mailto: address. Without them: no push.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Demo
# The secret in the demo desk link /desk?demo=<token>: 16 or more letters,
# digits, - or _. Make one with the SESSION_SECRET command. Without it: no demo desk.
DEMO_DESK_TOKEN=

# Privacy
# Where buyers write to complain about their data: an email address or a
# phone number. The privacy page shows it. Without it: the page says to write
# to the store on WhatsApp.
PRIVACY_CONTACT=

# For tools only. The app does not read these variables.
# NudgeBee API token for nbctl: avatar, API Tokens. It expires after 90 days.
NUDGEBEE_API_TOKEN=
# The Automation Webhook URL of the NudgeBee flag-change workflow (Admin,
# Integrations, Webhooks). Its token is the authentication: keep it secret.
# scripts/flagsmith-setup.ts makes it the Flagsmith webhook of the live
# environment. Without it: the script says how to set it.
NUDGEBEE_FLAG_WEBHOOK_URL=
